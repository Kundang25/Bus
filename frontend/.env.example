# App Environment
VITE_APP_ENV=development

# Backend URLs
VITE_API_BASE_URL=
VITE_BRIDGE_API_URL=

# Aadhaar config (public flags only)
VITE_AADHAAR_PROVIDER=UIDAI
VITE_AADHAAR_MODE=sandbox

# Feature flags
VITE_ENABLE_AADHAAR_VERIFICATION=true
VITE_ENABLE_QR_SCAN=true

# Logging
VITE_ENABLE_LOGS=true
